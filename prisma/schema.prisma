generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
}

model Prestamo {
  id                 String   @id @default(cuid())
  userId             String
  clienteNombre      String
  capitalInicial     Decimal
  tasaInteresMensual Decimal
  plazoMeses         Int      @default(6)
  fechaInicio        DateTime
  estado             String   @default("activo")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cuotas     Cuota[]
  documentos Documento[]
}

model Cuota {
  id                   String    @id @default(cuid())
  prestamoId           String
  mes                  Int
  fechaVencimiento     DateTime
  interesMensual       Decimal
  amortizacionCapital  Decimal
  cuotaTotal           Decimal
  montoPagado          Decimal   @default(0)
  fechaPago            DateTime?
  estado               String    @default("pendiente")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  prestamo Prestamo        @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  pagos    HistorialPago[]
}

model HistorialPago {
  id        String   @id @default(cuid())
  cuotaId   String
  monto     Decimal
  fechaPago DateTime
  metodo    String
  notas     String?
  createdAt DateTime @default(now())

  cuota Cuota @relation(fields: [cuotaId], references: [id], onDelete: Cascade)
}

model Documento {
  id            String   @id @default(cuid())
  prestamoId    String
  nombreArchivo String
  urlArchivo    String
  tipoArchivo   String
  tamaño        Int
  createdAt     DateTime @default(now())

  prestamo Prestamo @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
}
